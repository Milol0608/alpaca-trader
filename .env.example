# Copy to .env and fill in. .env is gitignored. Never commit or paste real keys.

# paper | live. Default is paper.
MODE=paper

# Live trading needs ALL of: MODE=live, this exact value, and a fresh gate_passed.json.
LIVE_TRADING_CONFIRMED=
GATE_FILE=gate_passed.json
GATE_MAX_AGE_DAYS=30

# Paper and live use SEPARATE key pairs (Alpaca dashboard -> Paper Trading -> API keys).
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# Free plan: IEX is the only real-time feed. See README "Data".
DATA_FEED=iex
